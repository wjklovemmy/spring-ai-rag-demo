<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>spring-ai-rag-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <!-- 聚合父工程：业务代码在子模块 spring-ai-rag -->
    <packaging>pom</packaging>
    <name>spring-ai-rag-demo</name>
    <description>spring-ai-rag-demo parent</description>
    <modules>
        <module>spring-ai-user</module>
        <module>spring-ai-rag</module>
        <module>gateway</module>
    </modules>
    <properties>
        <java.version>17</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- 覆盖 spring-ai-milvus-store 传递引入的旧版 SDK：2.5.9+ 引入 v2 客户端，支持 BM25 Hybrid Search -->
        <milvus-sdk.version>2.6.23</milvus-sdk.version>
        <!-- Spring Cloud / Spring Cloud Alibaba：2025.1.x 适配 Spring Boot 4.0.x（SCA 官方版本对应关系） -->
        <spring-cloud.version>2025.1.0</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
    </properties>
    <!--
      依赖下沉说明：
      父 POM <dependencies> 仅保留三个服务（spring-ai-rag / spring-ai-user / gateway）通用的依赖；
      Web / AOP / MyBatis-Plus / MySQL 驱动 / Redis / JWT / BCrypt 等业务专属依赖
      已下沉至各子模块显式声明（避免 gateway 这类 WebFlux 应用继承到
      spring-boot-starter-webmvc / mybatis-plus（触发 DataSource 自动配置）等无关依赖）。
    -->
    <dependencies>
        <!-- ==================== Nacos 注册中心 / 配置中心（三个服务统一接入） ====================
             版本由 spring-cloud-alibaba-dependencies BOM（2025.1.0.0）管理 -->
        <!-- Nacos 服务注册与发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心（spring.config.import 方式引入） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Spring Cloud LoadBalancer：网关 lb:// 路由 + Feign 服务间调用负载均衡 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- OpenFeign 声明式服务调用：替代 RestClient 实现服务间内部调用（RAG ↔ spring-ai-user） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- OpenFeign 熔断降级：Spring Cloud Circuit Breaker（Sentinel 实现）。
             说明：Netflix Hystrix 已 EOL（2021 停止维护），Spring Cloud 2020+ 移除其集成；
             Sentinel 的 SentinelCircuitBreaker 实现 spring-cloud-circuitbreaker 抽象，
             feign.circuitbreaker.enabled=true + fallbackFactory 即熔断降级方案。
             SentinelFeignClientAutoConfiguration 在引入本依赖后自动生效（spring.cloud.circuitbreaker.sentinel.enabled 默认 true），
             声明式规则配置见各服务 application.yaml 的 feign.sentinel.rules（default 键=所有 Feign 客户端默认规则）。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-circuitbreaker-sentinel</artifactId>
        </dependency>
        <!-- Sentinel transport：向 Sentinel Dashboard（可选）上报指标，默认端口 8719；未启动 Dashboard 时仅告警不影响运行 -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-transport-simple-http</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM（2025.1.0，适配 Spring Boot 4.0.x）：网关 lb:// 路由、负载均衡等 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM（2025.1.0.0）：Nacos 注册中心（服务发现）+ Nacos 配置中心 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring AI BOM 与 Milvus SDK 版本管理已下沉至 spring-ai-rag 模块（仅 RAG 使用） -->
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
