<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>spring-ai-rag-demo</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>spring-ai-rag</artifactId>
    <name>spring-ai-rag</name>
    <description>RAG 服务核心模块：PDF 文档入库（Milvus）与基于 DeepSeek 的知识问答</description>

    <!--
      依赖、版本管理与构建插件（spring-boot-maven-plugin、lombok 注解处理器等）
      全部继承自父工程 spring-ai-rag-demo，此处仅需声明用户域共享模块。
    -->
    <dependencies>
        <!-- 用户域共享模块（library）：用户/角色/JWT/登录态，同进程被本模块消费 -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>spring-ai-user</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
