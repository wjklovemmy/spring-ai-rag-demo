<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>spring-ai-rag-demo</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>spring-ai-rag</artifactId>
    <name>spring-ai-rag</name>
    <description>RAG 服务：PDF 文档入库（Milvus）与基于 DeepSeek 的知识问答。独立服务（8080），不依赖用户域模块</description>

    <!--
      依赖、版本管理与构建插件（spring-boot-maven-plugin、lombok 注解处理器等）
      继承自父工程 spring-ai-rag-demo。Spring AI / Milvus / MinIO / OCR 等仅本模块使用的
      依赖与版本管理在此声明；认证/用户域由独立服务 spring-ai-user（8082）承担，
      本服务仅通过网关透传的身份头（X-User-Id / X-Username / X-Permissions）与
      用户服务内部接口（/internal/users/**）完成身份与授权判定。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.milvus</groupId>
                <artifactId>milvus-sdk-java</artifactId>
                <version>${milvus-sdk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ==================== Web / 基础（MVC 应用，静态页面 + REST 接口） ====================
             注：spring-boot-starter-webmvc 已从父 POM <dependencies> 移除（避免 gateway 继承导致
             Spring MVC 与 WebFlux 冲突），此处由本模块显式声明 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- ==================== 持久化 / 安全（RAG 业务库 knowledge_base） ====================
             同样从父 POM 下沉：mybatis-plus 若留在父 POM 会让 gateway（WebFlux，无数据库）
             继承并触发 DataSource 自动配置报错 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.16</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.16</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Redis：多轮对话记忆（ChatMemory）持久化，与用户服务/网关共用同一实例 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Lettuce 连接池（配合 spring.data.redis.lettuce.pool 配置；与 spring-ai-user 一致） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <!-- RabbitMQ：Embedding 任务异步消息（持久化投递 + 失败重试 + 死信队列） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- ==================== AI / 向量 / 解析（RAG 专用） ==================== -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-milvus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pdf-document-reader</artifactId>
        </dependency>

        <!-- 对象存储（文档附件存储）；8.5.12 存在 CVE-2025-59952（XML 值替换），官方修复版为 8.6.0（8.x 分支，API 兼容）；
             9.x 为重大重构版（API 与 S3 规范同步，partSize 等签名有破坏性变更），暂不采用 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.6.0</version>
            <exclusions>
                <!-- okhttp 5.x 为 Kotlin Multiplatform 库，根 artifact（com.squareup.okhttp3:okhttp）只是空元数据 jar，
                     不含 JVM 类，会导致 javac 报"无法访问 okhttp3.HttpUrl"；此处回退到 4.x（单 artifact 经典结构，
                     与 8.5.12 时代的运行组合一致），避免 KMP 元数据 jar 导致的编译/运行时类缺失 -->
                <exclusion>
                    <groupId>com.squareup.okhttp3</groupId>
                    <artifactId>okhttp</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>

        <!-- 阿里云 OCR（扫描版 PDF 文字识别） -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>ocr_api20210707</artifactId>
            <version>3.1.3</version>
        </dependency>
    </dependencies>
</project>
